<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/futuristic_background">

    <com.lhht.aiassistant.RippleView android:id="@+id/ripple"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.lhht.aiassistant.MascotView
        android:id="@+id/mascot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot"
        android:contentDescription="小智吉祥物，长按五秒打开设置"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="24dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp" android:background="@drawable/status_capsule_background">
        <ImageView android:id="@+id/mic_status_icon" android:layout_width="20dp"
            android:layout_height="20dp" android:src="@drawable/ic_mic"
            android:tint="#708090" android:contentDescription="麦克风状态" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="正在启动监听" android:textColor="#526477" android:textSize="14sp" />
    </LinearLayout>

    <!-- Keep other views for existing listener logic. -->
    <ScrollView android:id="@+id/result_scroll" android:layout_width="match_parent"
        android:layout_height="180dp" android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="24dp" android:fillViewport="false"
        android:background="@drawable/status_capsule_background" android:visibility="gone">
        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="16sp" android:textIsSelectable="true" />
    </ScrollView>
    <TextView android:id="@+id/hold_hint" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
    <Button android:id="@+id/retry_button" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
</FrameLayout>
